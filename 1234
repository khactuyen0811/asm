        static string[] name_customer = new string[1000];
        static double[] water_bill_last_month = new double[1000];
        static double[] water_bill_next_month = new double[1000];
        static int[] type_customer = new int[1000];

        static int[] type_customers = new int[1000];
        static double water_meter;
       
